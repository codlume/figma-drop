{
  "name": "figma-drop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "app:install": "pnpm app:local && node scripts/install-local.mjs",
    "app:local": "rm -rf apps/desktop/dist apps/desktop/dist-electron && pnpm build && node scripts/package-local.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "vp run -r build",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint --report-unused-disable-directives",
    "typecheck": "vp run -r typecheck",
    "test": "vp run -r test",
    "release:dry-run": "pnpm app:local && node scripts/dmg.mjs --setup && node scripts/release-package.mjs --dry-run",
    "test:release": "node --test \"scripts/*.test.mjs\"",
    "dmg:setup": "node scripts/dmg.mjs --setup"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@11.10.0"
}
