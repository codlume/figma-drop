{
  "name": "figma-drop",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "app:local": "pnpm build && node scripts/package-local.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "vp run -r build",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint --report-unused-disable-directives",
    "typecheck": "vp run -r typecheck",
    "test": "vp run -r test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@11.10.0"
}
